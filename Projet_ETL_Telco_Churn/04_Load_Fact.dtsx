    Contract,
    PaperlessBilling,
    PaymentMethod,

    tenure,
    CASE
        WHEN tenure BETWEEN 0 AND 6 THEN '0-6 Month'
        WHEN tenure BETWEEN 7 AND 12 THEN '7-12 Month'
        WHEN tenure BETWEEN 13 AND 24 THEN '13-24 Month'
        WHEN tenure BETWEEN 25 AND 36 THEN '25-36 Month'
        WHEN tenure BETWEEN 37 AND 48 THEN '37-48 Month'
        WHEN tenure BETWEEN 49 AND 62 THEN '49-62 Month'
        ELSE '&gt; 62 Month'
    END AS TenureGroup,

    CASE
        WHEN MonthlyCharges &lt; 35 THEN 'Low'
        WHEN MonthlyCharges BETWEEN 35 AND 70 THEN 'Medium'
        ELSE 'High'
    END AS ChargeGroup,

    1 AS CustomerCount,
    ChurnFlag,
    MonthlyCharges,
    TotalCharges
FROM Clean_TelcoChurn;</property>

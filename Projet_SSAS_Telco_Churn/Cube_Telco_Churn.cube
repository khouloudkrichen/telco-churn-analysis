  <MdxScripts>
    <MdxScript dwd:design-time-name="1400e223-1050-4771-a947-0d1d0bd5eebb">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
La commande CALCULATE contrôle l'agrégation des cellules feuilles dans le cube.
Si la commande CALCULATE est supprimée ou modifiée, les données au sein du cube sont affectées.
Vous devez modifier cette commande uniquement si vous spécifiez manuellement la façon dont le cube est agrégé.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Retention Rate]
 AS IIF(
  [Measures].[Customer Count] = 0,
  NULL,
  1 - ([Measures].[Churn Flag] / [Measures].[Customer Count])
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'KPIs' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Churn'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Churn Rate]
 AS IIF(
  [Measures].[Customer Count] = 0,
  NULL,
  [Measures].[Churn Flag] / [Measures].[Customer Count]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'KPIs' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Churn'  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>